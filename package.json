{
  "name": "@hoakt/worldmachine-mcp",
  "version": "0.1.0",
  "description": "MCP server for local World Machine installations",
  "license": "MIT",
  "type": "module",
  "bin": {
    "worldmachine-mcp": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "pretest": "npm run build",
    "test": "vitest run",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "capture-fixtures": "node scripts/capture-fixtures.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:fixtures"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
